{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "planets": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "app",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/planets",
            "index": "view/index.html",
            "browser": "app/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "resources/images/stars",
                "output": "/images/stars"
              },
              {
                "glob": "**/*",
                "input": "resources/images/planets",
                "output": "/images/planets"
              },
              {
                "glob": "**/*",
                "input": "resources/images/moons",
                "output": "/images/moons"
              },
              {
                "glob": "**/*",
                "input": "resources/images/skybox",
                "output": "/images/skybox"
              },
              {
                "glob": "**/*",
                "input": "resources/stars",
                "output": "/resources/stars"
              },
              {
                "glob": "**/*",
                "input": "resources/planets",
                "output": "/resources/planets"
              },
              {
                "glob": "**/*",
                "input": "resources/moons",
                "output": "/resources/moons"
              }
            ],
            "styles": [
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "node_modules/bootstrap-icons/font/bootstrap-icons.min.css",
              "node_modules/@fontsource/share-tech-mono/400.css",
              "node_modules/@fontsource/orbitron/400.css",
              "node_modules/@fontsource/orbitron/700.css",
              "resources/styles/main.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "app/environments/environment.ts",
                  "with": "app/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2MB",
                  "maximumError": "4MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "16kB",
                  "maximumError": "32kB"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "planets:build:production"
            },
            "development": {
              "buildTarget": "planets:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest",
            "buildTarget": "planets:build:development"
          }
        }
      },
      "schematics": {
        "@schematics/angular:component": {
          "changeDetection": "OnPush"
        }
      }
    }
  },
  "cli": {
    "analytics": false,
    "packageManager": "npm"
  }
}
