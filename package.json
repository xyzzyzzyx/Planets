{
  "name": "planets",
  "version": "2.0.0",
  "private": true,
  "description": "WebGL solar-system explorer: Angular + three.js client with a Node simulation server.",
  "type": "module",
  "engines": {
    "node": "^22.22.3 || >=24.15.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "concurrently -k -n api,web -c cyan,magenta \"npm:backend\" \"npm:frontend\"",
    "frontend": "ng serve",
    "backend": "nodemon server.js",
    "server": "node server.js",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:server && npm run test:app",
    "test:server": "vitest run --config vitest.server.config.mjs",
    "test:app": "ng test --watch=false",
    "test:coverage": "vitest run --config vitest.server.config.mjs --coverage && ng test --watch=false --coverage",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "certs": "node scripts/certs.js --force",
    "harvest": "node scripts/harvest.js",
    "reset": "rimraf resources/universe.json",
    "clean": "rimraf dist .angular coverage",
    "updates": "npm-check-updates",
    "update": "npm-check-updates -u",
    "docs:build": "compodoc -p tsconfig.app.json -d documentation",
    "docs:serve": "compodoc -s -d documentation"
  },
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "rxjs": "^7.8.2",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@compodoc/compodoc": "^2.0.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3",
    "nodemon": "^3.1.14",
    "npm-check-updates": "^23.1.1",
    "rimraf": "^6.1.3",
    "selfsigned": "^5.5.0",
    "supertest": "^7.3.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "nodemonConfig": {
    "watch": [
      "server.js",
      "server/",
      "shared/",
      "resources/stars/",
      "resources/planets/",
      "resources/moons/"
    ],
    "ignore": [
      "**/*.test.js",
      "resources/universe.json*"
    ],
    "ext": "js,json"
  }
}
